{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vitest/globals", "node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "main.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/tests/**/*.ts",
    "packages/docs/.vitepress/**/*.ts",
    "packages/docs/samples/**/*.ts",
    "test/**/*.ts",
    "playwright.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "dist", "out", "**/__mocks__"]
}
