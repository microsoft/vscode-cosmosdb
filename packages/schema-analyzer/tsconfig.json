{
  "compilerOptions": {
    // Strictness
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,

    // Module: standalone ESM library (no bundler)
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024"],

    // Other
    // Embed TypeScript in JS maps so standalone consumers can debug without a separate src/ directory.
    // Declaration maps retain source paths, but TypeScript does not embed source text in them.
    "sourceMap": true,
    "inlineSources": true,
    "resolveJsonModule": true,

    // Output
    "outDir": "dist/esm",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationDir": "dist/types",
    "declarationMap": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts", "**/fixtures.ts"]
}
