{
  "compilerOptions": {
    // Strictness
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,

    // Module: standalone ESM library (no bundler)
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],

    // Other
    // sourceMap/declarationMap are OFF: this tsc invocation only produces the
    // standalone publishable dist/ (npm pack), and package.json's "files" does
    // not ship src/, so .js.map/.d.ts.map here would point at files consumers
    // never receive. The monorepo build never consumes this package's dist —
    // it resolves straight to src/ via path aliases (see packages/README.md) —
    // so local/vite-bundled builds are unaffected by this.
    "sourceMap": false,
    "resolveJsonModule": true,

    // Output
    "outDir": "dist/esm",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist/types",
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@azure/cosmosdb-schema-analyzer": ["../schema-analyzer/src/index.ts"],
      "@azure/cosmosdb-schema-analyzer/*": ["../schema-analyzer/src/*.ts", "../schema-analyzer/src/*/index.ts"]
    }
  },
  "references": [{ "path": "../schema-analyzer" }],
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts"]
}
