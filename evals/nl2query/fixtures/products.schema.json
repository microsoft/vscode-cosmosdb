{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Synthetic product",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "price": { "type": "number" },
    "inStock": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["id", "name", "price", "inStock", "tags"],
  "additionalProperties": false
}
